# Build artifacts and dependencies (rebuilt inside the image)
node_modules
dist
coverage
*.tsbuildinfo

# VCS
.git
.gitignore
.gitattributes
.github

# Local config / secrets
.env
.env.*

# Tests and dev tooling (not needed in runtime image)
tests
