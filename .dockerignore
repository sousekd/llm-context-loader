tsconfig.test.json
scripts

# Logs and editor noise
npm-debug.log*
*.log
.vscode
.idea
.DS_Store

# Repo docs (kept in the source tree, excluded from the image to keep it small)
README.md
docs
AGENTS.md
CONTRIBUTING.md
docker-compose*.yml
compose*.yaml
