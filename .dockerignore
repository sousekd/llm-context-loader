# Build artifacts and dependencies rebuilt inside the image
node_modules
dist
coverage
*.tsbuildinfo

# VCS
.git
.gitignore
.gitattributes
.github

# Environment files are supplied at runtime, never baked into the image
.env
.env.*

# Tests and dev tooling not needed in the runtime image
tests
vitest.config.ts
tsconfig.test.json
scripts

# Logs and editor noise
npm-debug.log*
*.log
.vscode
.idea
.DS_Store

# Repository docs stay outside the runtime image
README.md
docs
AGENTS.md
CONTRIBUTING.md
docker-compose*.yml
compose*.yaml
